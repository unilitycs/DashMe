      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Usa_recalls)' name='federated.1c5t1fs14y8upf1cq8u8p1h4f81k' />
          </datasources>
          <datasource-dependencies datasource='federated.1c5t1fs14y8upf1cq8u8p1h4f81k'>
            <column caption='Conteggio prodotti' datatype='integer' name='[Calculation_0166850900070400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Product ID])' />
            </column>
            <column caption='Portata Distributiva' datatype='string' name='[Calculation_1000000000000000004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Trasforma l&apos;attributo multivalore Modello di distribuzione in portata geografica atomica&#13;&#10;IF CONTAINS(LOWER([Distribution Pattern]), &quot;worldwide&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot;internat&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot;canada&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot;mexico&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot;foreign&quot;) THEN&#13;&#10;    &quot;Internazionale / Export&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Distribution Pattern]), &quot;nationwide&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot;national&quot;) THEN&#13;&#10;    &quot;Nazionale (Tutti gli USA)&quot;&#13;&#10;ELSEIF CONTAINS([Distribution Pattern], &quot;,&quot;)&#13;&#10;   OR CONTAINS(LOWER([Distribution Pattern]), &quot; and &quot;) THEN&#13;&#10;    &quot;Regionale (Multi-Stato)&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Locale (Singolo Stato)&quot;&#13;&#10;END' />
            </column>
            <column caption='Modello di distribuzione' datatype='string' name='[Distribution Pattern]' role='dimension' type='nominal' />
            <column caption='Classe Prodotto' datatype='string' name='[Product Classification]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Class I&quot;' value='Classe I' />
                <alias key='&quot;Class II&quot;' value='Classe II' />
                <alias key='&quot;Class III&quot;' value='Classe III' />
              </aliases>
            </column>
            <column caption='ID Prodotto' datatype='integer' name='[Product ID]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1000000000000000004]' derivation='None' name='[none:Calculation_1000000000000000004:nk]' pivot='key' type='nominal' />
            <column-instance column='[Product Classification]' derivation='None' name='[none:Product Classification:nk]' pivot='key' type='nominal' />
