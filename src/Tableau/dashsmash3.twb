  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Dashboard 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1b1b1b' fontname='Al Bayan' fontsize='24'>Governance Operativa, Portata Distributiva, Conservazione e Packaging</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dash-title'>
          <format attr='text-align' value='left' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='Sheet1 (Usa_recalls)' name='federated.1c5t1fs14y8upf1cq8u8p1h4f81k' />
      </datasources>
      <datasource-dependencies datasource='federated.1c5t1fs14y8upf1cq8u8p1h4f81k'>
        <column caption='Categoria Ragione di Richiamo' datatype='string' name='[Calculation_1000000000000000001]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='// Categorizzazione del campo Ragione di Richiamo ([Reason for Recall])&#13;&#10;IF CONTAINS(LOWER([Reason for Recall]), &quot;listeria&quot;) THEN&#13;&#10;    &quot;Listeria&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;salmonella&quot;) THEN&#13;&#10;    &quot;Salmonella&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;e. coli&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;e.coli&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;escherichia&quot;) THEN&#13;&#10;    &quot;E.Coli&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;sildenafil&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;tadalafil&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;vardenafil&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;sibutramine&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;phenolphthalein&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;dapoxetine&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;diclofenac&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;dexamethasone&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;steroid&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;pharmaceutical&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;unapproved new drug&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;undeclared active&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;undeclared drug&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;drug substance&quot;) THEN&#13;&#10;    &quot;adulterazioni farmaci&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;allergen&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;undeclared&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains milk&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains peanut&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains soy&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains egg&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains wheat&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains almond&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains walnut&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains cashew&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains pecan&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains hazelnut&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains pistachio&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains coconut&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains tree nut&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains fish&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains shellfish&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;contains sesame&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;sulfite&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;sulphite&quot;) THEN&#13;&#10;    &quot;Allergeni non dichiarati&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;foreign&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;metal&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;plastic&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;glass&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;wood&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;rubber&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;stone&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;rock&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;insect&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;rodent&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;bone&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;fragment&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;shaving&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;wire&quot;) THEN&#13;&#10;    &quot;Corpi estranei&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Reason for Recall]), &quot;adulterat&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;cgmp&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;subpotent&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;superpotent&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;impurity&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;impurities&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;ndma&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;nitrosamine&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;dissolution&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;sterility&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;penicillin&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;cross-contamination&quot;)&#13;&#10;    OR CONTAINS(LOWER([Reason for Recall]), &quot;cross contamination&quot;) THEN&#13;&#10;    &quot;adulterazioni farmaci&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Altro&quot;&#13;&#10;END' />
        </column>
        <column caption='Tipo Packaging' datatype='string' name='[Calculation_1000000000000000010]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='// Estrae il tipo di confezionamento dall&apos;attributo composto Descrizione Prodotto&#13;&#10;IF CONTAINS(LOWER([Product Description]), &quot;glass&quot;) OR CONTAINS(LOWER([Product Description]), &quot;jar&quot;) OR CONTAINS(LOWER([Product Description]), &quot;bottle&quot;) THEN &quot;Vetro / Bottiglia / Barattolo&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Product Description]), &quot;plastic&quot;) OR CONTAINS(LOWER([Product Description]), &quot;pouch&quot;) OR CONTAINS(LOWER([Product Description]), &quot;bag&quot;) THEN &quot;Plastica / Busta&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Product Description]), &quot;can&quot;) OR CONTAINS(LOWER([Product Description]), &quot;aluminum&quot;) OR CONTAINS(LOWER([Product Description]), &quot;metal&quot;) THEN &quot;Lattina / Metallo&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Product Description]), &quot;box&quot;) OR CONTAINS(LOWER([Product Description]), &quot;carton&quot;) OR CONTAINS(LOWER([Product Description]), &quot;paper&quot;) THEN &quot;Cartone / Scatola&quot;&#13;&#10;ELSE &quot;Altro / Non specificato&quot;&#13;&#10;END' />
        </column>
        <column-instance column='[Calculation_1000000000000000001]' derivation='None' name='[none:Calculation_1000000000000000001:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1000000000000000010]' derivation='None' name='[none:Calculation_1000000000000000010:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
